#!/usr/bin/env bash
# Fail closed when checked-in source or release payloads contain developer-owned
# SSH target identifiers. Test fixtures must use reviewed remote-fixture names.
set -euo pipefail

WORKSPACE_ROOT_DIR="${ASHIDE_RELEASE_PRIVACY_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
cd "$WORKSPACE_ROOT_DIR"

artifact_roots=()
while (( "$#" )); do
  case "$1" in
    --artifacts)
      artifact_roots+=("$2")
      shift 2
      ;;
    *)
      echo "unknown arg: $1" >&2
      exit 1
      ;;
  esac
done

fail=0
scratch="$(mktemp -d "${TMPDIR:-/tmp}/ashide-release-privacy.XXXXXX")"
trap 'rm -rf "$scratch"' EXIT
private_tokens="$scratch/private-tokens"
: > "$private_tokens"

local_tokens_file="${ASHIDE_PRIVATE_RELEASE_TOKENS_FILE:-$(git rev-parse --git-path ashide-private-release-tokens)}"
if [[ -f "$local_tokens_file" ]]; then
  cat "$local_tokens_file" >> "$private_tokens"
fi
if [[ -n "${ASHIDE_PRIVATE_RELEASE_TOKENS:-}" ]]; then
  printf '%s\n' "$ASHIDE_PRIVATE_RELEASE_TOKENS" >> "$private_tokens"
fi

# Only generic, reviewable fixtures may be committed as ssh-config authorities.
is_allowed_fixture() {
  [[ "$1" =~ ^(authority|different-owner|explicit|first|host|missing-test-host|o1|other-owner|remote-fixture(-[a-z0-9-]+)?|second|source-owner|test)$ ]]
}

check_ssh_config_refs_from_stream() {
  local connection_ref fixture
  while IFS= read -r connection_ref; do
    [[ -z "$connection_ref" ]] && continue
    fixture="${connection_ref#ssh:ssh-config:}"
    fixture="${fixture#ssh-config:}"
    if ! is_allowed_fixture "$fixture"; then
      echo "release privacy check: non-generic ssh-config fixture found in publishable content" >&2
      fail=1
      return
    fi
  done
}

is_allowed_root_target() {
  [[ "$1" =~ ^remote-fixture(-[a-z0-9-]+)?$ ]] \
    || [[ "$1" =~ ^example([.][A-Za-z0-9.-]+)?$ ]] \
    || [[ "$1" == "vps" ]] \
    || [[ "$1" =~ ^[0-9]{1,3}([.][0-9]{1,3}){3}$ ]]
}

check_root_targets_from_stream() {
  local target host
  while IFS= read -r target; do
    [[ -z "$target" ]] && continue
    host="${target#root@}"
    if ! is_allowed_root_target "$host"; then
      echo "release privacy check: non-generic root SSH target found in publishable content" >&2
      fail=1
      return
    fi
  done
}

check_private_tokens_in_git() {
  local token
  while IFS= read -r token; do
    token="${token%%#*}"
    token="${token#${token%%[![:space:]]*}}"
    token="${token%${token##*[![:space:]]}}"
    [[ -z "$token" ]] && continue
    if git grep -I -q -i -F -- "$token"; then
      echo "release privacy check: a local private token is present in tracked source" >&2
      fail=1
    fi
  done < "$private_tokens"
}

scan_publishable_text_pattern() {
  local path="$1" pattern="$2" candidate mime
  while IFS= read -r -d '' candidate; do
    case "$candidate" in
      *.dmg|*.zip|*.tar.gz|*.tgz)
        continue
        ;;
    esac
    mime="$(file -b --mime-type "$candidate" 2>/dev/null || true)"
    case "$mime" in
      text/*|application/json|application/xml|application/x-plist|application/toml|application/yaml|application/x-yaml)
        rg -o --no-filename "$pattern" "$candidate" 2>/dev/null || true
        ;;
    esac
  done < <(find "$path" -type f -print0 2>/dev/null)
}

check_path() {
  local path="$1" token
  while IFS= read -r token; do
    token="${token%%#*}"
    token="${token#${token%%[![:space:]]*}}"
    token="${token%${token##*[![:space:]]}}"
    [[ -z "$token" ]] && continue
    if rg -a -q -i -F -- "$token" "$path"; then
      echo "release privacy check: a local private token is present in a release payload" >&2
      fail=1
    fi
  done < "$private_tokens"

  check_ssh_config_refs_from_stream < <(
    scan_publishable_text_pattern \
      "$path" '(ssh:ssh-config:|ssh-config:)[A-Za-z0-9._-]+' \
      | sort -u || true
  )
  check_root_targets_from_stream < <(
    scan_publishable_text_pattern \
      "$path" 'root@[A-Za-z0-9][A-Za-z0-9._-]+' \
      | sort -u || true
  )
}

check_archive() {
  local archive="$1" unpack_dir mount_dir
  case "$archive" in
    *.zip)
      unpack_dir="$(mktemp -d "$scratch/zip.XXXXXX")"
      unzip -qq "$archive" -d "$unpack_dir"
      check_path "$unpack_dir"
      ;;
    *.tar.gz|*.tgz)
      unpack_dir="$(mktemp -d "$scratch/tar.XXXXXX")"
      tar -xzf "$archive" -C "$unpack_dir"
      check_path "$unpack_dir"
      ;;
    *.dmg)
      if [[ "$(uname -s)" == "Darwin" ]]; then
        hdiutil verify "$archive" >/dev/null
        mount_dir="$(mktemp -d "$scratch/dmg.XXXXXX")"
        hdiutil attach -readonly -nobrowse -mountpoint "$mount_dir" "$archive" >/dev/null
        check_path "$mount_dir"
        hdiutil detach "$mount_dir" >/dev/null
      fi
      ;;
  esac
}

check_ssh_config_refs_from_stream < <(
  git grep -I -h -o -E '(ssh:ssh-config:|ssh-config:)[A-Za-z0-9._-]+' -- . 2>/dev/null \
    | sort -u || true
)
check_root_targets_from_stream < <(
  git grep -I -h -o -E 'root@[A-Za-z0-9][A-Za-z0-9._-]+' -- . 2>/dev/null \
    | sort -u || true
)
check_private_tokens_in_git

if (( ${#artifact_roots[@]} )); then
  for root in "${artifact_roots[@]}"; do
    if [[ ! -e "$root" ]]; then
      echo "release privacy check: artifact path does not exist: $root" >&2
      fail=1
      continue
    fi
    check_path "$root"
    while IFS= read -r -d '' archive; do
      check_archive "$archive"
    done < <(find "$root" -type f \( -name '*.zip' -o -name '*.tar.gz' -o -name '*.tgz' -o -name '*.dmg' \) -print0)
  done
fi

if [[ "$fail" -ne 0 ]]; then
  echo "release privacy checks failed" >&2
  exit 1
fi

echo "release privacy checks passed"
