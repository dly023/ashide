#!/bin/bash
#
# Bundle the application for distribution.
#
# See the parameter parsing section below for available options.
#
# Note that there are several steps to complete before the app is ready to
# be distributed, one of which is asynchronous and requires apple to process
# our binary.
#
# The exact steps depend on which artifact we are building, the desktop app or the CLI. Overall,
# the steps are:
#
# 1) Create the binary or mac bundle by running `cargo`.
# 2) Create a keychain based on our distribution cert.
# 3) Codesign the built artifact using the keychain.
#
# Additionally, for an app, we create a dmg:
# 4) Create and verify the DMG using the repository-owned `diskutil image` pipeline.
# 5) Codesign our dmg using the keychain.
# 6) Upload the app to Apple for it to be notarized - this is async, and we
#    poll until it is done.
# 7) "Staple" the notarization to the dmg.
#
# Once the stapling is done, the app can be shared.
#
# Three passwords are read from GCP Secret Manager (or from env if --read-passwords-from-env is set) if you are codesigning.
# 1) ASHIDE_NOTARIZATION_PASSWORD:  This is an app-specific password.
#    See https://support.apple.com/en-us/HT204397
# 2) ASHIDE_DEVELOPER_ID_CERT_PASSWORD: This is a password tied to the private key
#    of our cert - it is needed to use the cert to sign our binary.
# 3) ASHIDE_CODESIGN_KEYCHAIN_PASSWORD: This is an arbitrary password only used
#    in the lifetime of this app for creating the keychain used to sign.  Can
#    be anything.
#
# See
# https://github.com/burtonageo/cargo-bundle
# https://wiki.lazarus.freepascal.org/Code_Signing_for_macOS
# https://wiki.lazarus.freepascal.org/Notarization_for_macOS_10.14.5%2B
# https://developer.apple.com/developer-id/
# https://github.com/atom/atom/blob/976cb9ef3a611163052f9d31c6c3685dc1e6c5b4/script/lib/code-sign-on-mac.js

set -e

# Determine the repository root directory
WORKSPACE_ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

# This is used to set the minimum deployment target for mac
# https://cmake.org/cmake/help/latest/envvar/MACOSX_DEPLOYMENT_TARGET.html
# If unset, it uses the system one, but we want to build for older versions
# of mac os by default.
#
# This should be kept in sync with the definition of this variable in
# `.cargo/config.toml`.
export MACOSX_DEPLOYMENT_TARGET="10.14"

# Constants used later in the script.
INTEL_ARCH="x86_64"
INTEL_TARGET="$INTEL_ARCH-apple-darwin"
ARM_ARCH="aarch64"
ARM_TARGET="$ARM_ARCH-apple-darwin"
DEFAULT_ARCH="$(rustc --print cfg | grep target_arch)"

# The Rust target triple corresponding to the build host. Used below to
# decide whether to forward --target to `cargo run` for the settings schema
# generator: that step needs to execute its compiled binary, so we can only
# pass a target that's runnable on the host.
if [[ "$DEFAULT_ARCH" == *"$INTEL_ARCH"* ]]; then
    HOST_TARGET="$INTEL_TARGET"
elif [[ "$DEFAULT_ARCH" == *"$ARM_ARCH"* ]]; then
    HOST_TARGET="$ARM_TARGET"
fi

# Clean up the temporary codesigning keychain.
cleanup_codesign_keychain() {
    if [[ "${CODESIGN:-false}" = true && -n "${CODESIGN_KEYCHAIN_NAME:-}" ]]; then
        echo "Cleaning up by deleting $CODESIGN_KEYCHAIN_NAME keychain."
        security delete-keychain "$CODESIGN_KEYCHAIN_NAME" || echo "No keychain to delete or already deleted."
    fi
}

# Set up cleanup trap
trap cleanup_codesign_keychain EXIT

# Define a helper function that uses Python to compute a relative path.
function relpath() {
  python -c "import os,sys;print(os.path.relpath(*(sys.argv[1:])))" "$@";
}

function plist_set_string() {
  local plist_path="$1"
  local key="$2"
  local value="$3"

  plutil -replace "$key" -string "$value" "$plist_path" 2>/dev/null || \
    plutil -insert "$key" -string "$value" "$plist_path"
}

function plist_set_bool() {
  local plist_path="$1"
  local key="$2"
  local value="$3"

  plutil -replace "$key" -bool "$value" "$plist_path" 2>/dev/null || \
    plutil -insert "$key" -bool "$value" "$plist_path"
}

function assert_app_bundle_plist_contract() {
  local plist_path="$BUNDLE_DIR/$ASHIDE_APP_NAME.app/Contents/Info.plist"
  local single_instance

  single_instance=$(plutil -extract LSMultipleInstancesProhibited raw -o - "$plist_path" 2>/dev/null || true)
  if [[ "$single_instance" != "true" ]]; then
    echo "Release bundle contract violated: LSMultipleInstancesProhibited must be true in $plist_path" >&2
    exit 1
  fi
}

function seal_and_verify_app_bundle() {
  local app_bundle="$BUNDLE_DIR/$ASHIDE_APP_NAME.app"

  if [[ $CODESIGN = false && $SELFSIGN = false ]]; then
    echo "Ad-hoc sealing unsigned app bundle $app_bundle..."
    codesign --force --deep --sign - --timestamp=none "$app_bundle"
  fi

  echo "Verifying complete app bundle seal for $app_bundle..."
  codesign --verify --deep --strict --verbose=4 "$app_bundle"
}

function ensure_framework_rpath() {
  local binary_path="$1"
  local framework_rpath="@executable_path/../Frameworks"

  if otool -l "$binary_path" | awk -v expected="$framework_rpath" '
    $1 == "cmd" && $2 == "LC_RPATH" { in_rpath = 1; next }
    in_rpath && $1 == "path" {
      if ($2 == expected) found = 1
      in_rpath = 0
    }
    END { exit(found ? 0 : 1) }
  '; then
    echo "Framework rpath already exists in $binary_path"
  else
    install_name_tool -add_rpath "$framework_rpath" "$binary_path"
  fi
}

function normalize_cargo_bundle_app() {
  local cargo_bundle_app_name="Ashide"
  local expected_bundle="$BUNDLE_DIR/$ASHIDE_APP_NAME.app"
  local cargo_bundle="$BUNDLE_DIR/$cargo_bundle_app_name.app"
  local plist_path="$expected_bundle/Contents/Info.plist"

  if [[ -d "$cargo_bundle" ]]; then
    if [[ "$cargo_bundle" != "$expected_bundle" ]]; then
      echo "Normalizing cargo-bundle output $cargo_bundle to $expected_bundle"
      rm -rf "$expected_bundle"
      mv "$cargo_bundle" "$expected_bundle"
    fi
  elif [[ ! -d "$expected_bundle" ]]; then
    echo "Expected app bundle at $expected_bundle or $cargo_bundle" >&2
    exit 1
  fi

  if [[ ! -f "$plist_path" ]]; then
    echo "Expected Info.plist at $plist_path" >&2
    exit 1
  fi

  plist_set_string "$plist_path" "CFBundleDisplayName" "$ASHIDE_APP_NAME"
  plist_set_string "$plist_path" "CFBundleName" "$ASHIDE_APP_NAME"
  plist_set_string "$plist_path" "CFBundleIdentifier" "$BUNDLE_ID"
  plist_set_bool "$plist_path" "LSMultipleInstancesProhibited" true
}

# Defaults for command-line flags.
UNIVERSAL_BINARY=true
BUILD_BINARY=true
TARGET_ARCH=""
DMG_NAME_SUFFIX=""
# By default we build dev bundles.
RELEASE_CHANNEL="dev"
FEATURES="release_bundle,extern_plist"
REGISTER_SERVICES=true
DEBUG=false
ARTIFACT="app"
CODESIGN=true
SELFSIGN=false
OPEN_AFTER_BUNDLE=false
READ_PASSWORDS_FROM_ENV=false
DISTRIBUTION="development"

PARAMS=""
while (( "$#" )); do
  case "$1" in
    # Speed up compilation time by only compiling a debug version of the app,
    # rather than a release version
    --debug)
      DEBUG=true
      shift
      ;;
    # Only run `cargo check` without producing a bundle
    --check-only)
      echo 'Only running `cargo check` and not producing a bundle.'
      CHECK_ONLY="true"
      shift
      ;;
    # Skip building the binary (assume it's already built)
    --skip-build)
      echo "Skipping binary build step."
      BUILD_BINARY=false
      shift
      ;;
    # Skip code signing process
    --nosign)
      echo "Skipping Developer ID signing and notarization; app bundles remain ad-hoc sealed."
      CODESIGN=false
      SELFSIGN=false
      shift
      ;;
    # Sign with a local Apple Development cert instead of the official Ashide cert.
    # Useful for local debug builds when you don't have access to the company signing key.
    # Falls back to ad-hoc signing if no Apple Development cert is found.
    --selfsign)
      echo "Self-signing enabled."
      CODESIGN=false
      SELFSIGN=true
      shift
      ;;
    # Build only for the default target architecture instead of universal binary
    --nouniversal)
      echo "Only building for default target $DEFAULT_TARGET, not a universal binary."
      UNIVERSAL_BINARY=false
      shift
      ;;
    # Build only for a specific architecture (implies --nouniversal)
    --arch)
      if [ -n "$2" ] && [ "${2:0:1}" != "-" ]; then
        if [ "$2" = "x86_64" -o "$2" = "aarch64" ]; then
          echo "Building for specific architecture: $2"
          TARGET_ARCH=$2
          UNIVERSAL_BINARY=false
          shift 2
        else
          echo "Error: --arch must be either x86_64 or aarch64, got '$2'" >&2
          exit 1
        fi
      else
        echo "Error: Argument for $1 is missing" >&2
        exit 1
      fi
      ;;
    # Set a custom suffix for the DMG file
    --dmg-name-suffix)
      if [ -n "$2" ] && [ "${2:0:1}" != "-" ]; then
        echo "Setting custom DMG name suffix to $2"
        DMG_NAME_SUFFIX=$2
        shift 2
      else
        echo "Error: Argument for $1 is missing" >&2
        exit 1
      fi
      ;;
    # Open the parent directory after bundling completes.
    -o|--open)
      OPEN_AFTER_BUNDLE=true
      shift
      ;;
    # Specify the release channel (local, dev, preview, stable, oss)
    -c|--channel)
      if [ -n "$2" ] && [ "${2:0:1}" != "-" ]; then
        RELEASE_CHANNEL=$2
        shift 2
      else
        echo "Error: Argument for $1 is missing" >&2
        exit 1
      fi
      ;;
    # Set a specific Git release tag for the build
    --release-tag)
      if [ -n "$2" ] && [ "${2:0:1}" != "-" ]; then
        echo "Setting release tag to $2"
        export GIT_RELEASE_TAG=$2
        shift 2
      else
        echo "Error: Argument for $1 is missing" >&2
        exit 1
      fi
      ;;
    # Read codesigning passwords from environment variables instead of GCP secret manager
    --read-passwords-from-env)
        echo "Reading codesigning passwords from env."
        READ_PASSWORDS_FROM_ENV=true
        shift
        ;;
    --distribution)
      if [[ "${2:-}" == "public" || "${2:-}" == "development" ]]; then
        DISTRIBUTION="$2"
        shift 2
      else
        echo "Error: --distribution must be public or development" >&2
        exit 1
      fi
      ;;
    --features)
      if [ -n "$2" ] && [ "${2:0:1}" != "-" ]; then
        echo "Adding Cargo features: $2"
        FEATURES="$FEATURES,$2"
        shift 2
      else
        echo "Error: Argument for $1 is missing" >&2
        exit 1
      fi
      ;;
    --artifact)
      if [ -n "$2" ] && [ "${2:0:1}" != "-" ]; then
        if [[ "$2" != "app" && "$2" != "cli" ]]; then
          echo "Error: --artifact must be either 'app' or 'cli', got '$2'" >&2
          exit 1
        fi
        ARTIFACT="$2"
        shift 2
      else
        echo "Error: Argument for $1 is missing" >&2
        exit 1
      fi
      ;;
    *) # preserve positional arguments
      PARAMS="$PARAMS $1"
      shift
      ;;
  esac
done
# set positional arguments in their proper place
eval set -- "$PARAMS"

if [[ "$DISTRIBUTION" == "public" && "$READ_PASSWORDS_FROM_ENV" != true ]]; then
  echo "Public macOS distributions require explicit Developer ID and notarization credentials." >&2
  exit 1
fi
if [[ "$DISTRIBUTION" == "public" && ( "$CODESIGN" != true || "$SELFSIGN" == true ) ]]; then
  echo "Public macOS distributions cannot use --nosign or --selfsign." >&2
  exit 1
fi
if [[ "$READ_PASSWORDS_FROM_ENV" == true ]]; then
  RESOLVED_SIGNING_MODE="$("$WORKSPACE_ROOT_DIR/script/macos/resolve_signing_mode")"
  if [[ "$RESOLVED_SIGNING_MODE" != "signed" ]]; then
    echo "--read-passwords-from-env requires a complete target-owned signing configuration" >&2
    exit 1
  fi
fi

# Infer a cargo profile from the bundle configuration.
if [[ $DEBUG = true ]]; then
  CARGO_PROFILE="dev"
elif [[ $RELEASE_CHANNEL = "local" || $RELEASE_CHANNEL = "dev" ]]; then
  # For dev bundles, we want to enable debug assertions to
  # catch violations that would otherwise silently pass in
  # a normal release build (e.g. in stable).
  if [[ "$ARTIFACT" == "cli" ]]; then
    CARGO_PROFILE="release-cli-debug_assertions"
  else
    CARGO_PROFILE="release-lto-debug_assertions"
  fi
else
  if [[ "$ARTIFACT" == "cli" ]]; then
    CARGO_PROFILE="release-cli"
  else
    CARGO_PROFILE="release-lto"
  fi
fi

TARGET_PROFILE_DIR="$CARGO_PROFILE"
if [[ "$CARGO_PROFILE" == "dev" ]]; then
  TARGET_PROFILE_DIR="debug"
fi

if [[ $RELEASE_CHANNEL = "local" ]]; then
    ASHIDE_BIN="ashide"
    ASHIDE_APP_NAME="AshideLocal"
    BUNDLE_ID="dev.ashide.$ASHIDE_APP_NAME"
    ASHIDE_SCHEME_NAME="ashidelocal"
    FEATURES="$FEATURES,agent_mode_debug"
    # 本地构建可覆盖 bundled framework 版本,供 app/build.rs 在 cargo bundle 期间读取。
    export FRAMEWORK_OVERRIDE="dev"
elif [[ $RELEASE_CHANNEL = "dev" ]]; then
    ASHIDE_BIN="ashide"
    ASHIDE_APP_NAME="AshideDev"
    BUNDLE_ID="dev.ashide.$ASHIDE_APP_NAME"
    ASHIDE_SCHEME_NAME="ashidedev"
    FEATURES="$FEATURES,agent_mode_debug"
    # Enable heap usage tracking & profiling using jemalloc through pprof.
    FEATURES="$FEATURES,jemalloc_pprof,heap_usage_tracking"
    # Dev 构建可覆盖 bundled framework 版本,供 app/build.rs 在 cargo bundle 期间读取。
    export FRAMEWORK_OVERRIDE="dev"
    export HANDLE_MARKDOWN=1
elif [[ $RELEASE_CHANNEL = "preview" ]]; then
    ASHIDE_BIN="ashide"
    ASHIDE_APP_NAME="AshidePreview"
    BUNDLE_ID="dev.ashide.$ASHIDE_APP_NAME"
    ASHIDE_SCHEME_NAME="ashidepreview"
    FEATURES="$FEATURES,preview_channel"
    # Enable heap usage tracking & profiling using jemalloc through pprof.
    FEATURES="$FEATURES,jemalloc_pprof,heap_usage_tracking"
elif [[ $RELEASE_CHANNEL = "stable" ]]; then
    ASHIDE_BIN="ashide"
    ASHIDE_APP_NAME="Ashide"
    BUNDLE_ID="dev.ashide.$ASHIDE_APP_NAME"
    ASHIDE_SCHEME_NAME="ashide"
elif [[ $RELEASE_CHANNEL = "oss" ]]; then
    ASHIDE_BIN="ashide"
    ASHIDE_APP_NAME="Ashide"
    BUNDLE_ID="dev.ashide.$ASHIDE_APP_NAME"
    ASHIDE_SCHEME_NAME="ashide"
    # autoupdate 走 GitHub Release,仅下载 DMG 到 Downloads,不自动覆盖 .app。
    FEATURES="release_bundle,extern_plist,autoupdate"
fi

ICON_ASSET_CHANNEL="$RELEASE_CHANNEL"
if [[ ! -d "$WORKSPACE_ROOT_DIR/app/channels/$ICON_ASSET_CHANNEL" ]]; then
    echo "No app/channels/$ICON_ASSET_CHANNEL icon tree; falling back to canonical Ashide icons at app/channels/oss/icon/"
    ICON_ASSET_CHANNEL="oss"
fi
echo "Using icon asset channel: $ICON_ASSET_CHANNEL (canonical brand: app/channels/oss/icon/)"

OUT_DIR="target/$TARGET_PROFILE_DIR/bundle/osx"

# Handle specific architecture targeting
if [[ -n "$TARGET_ARCH" ]]; then
    # Building for a specific architecture
    if [[ "$TARGET_ARCH" == "$INTEL_ARCH" ]]; then
        echo "Building specifically for $INTEL_TARGET"
        DEFAULT_TARGET="$INTEL_TARGET"
        BUNDLE_DIR="target/$INTEL_TARGET/$TARGET_PROFILE_DIR/bundle/osx"
    elif [[ "$TARGET_ARCH" == "$ARM_ARCH" ]]; then
        echo "Building specifically for $ARM_TARGET"
        DEFAULT_TARGET="$ARM_TARGET"
        BUNDLE_DIR="target/$ARM_TARGET/$TARGET_PROFILE_DIR/bundle/osx"
    fi
else
    # Auto-detect default target based on current architecture
    if [[ "$DEFAULT_ARCH" == *"$INTEL_ARCH"* ]]; then
        echo "Default target is $INTEL_TARGET"
        DEFAULT_TARGET="$INTEL_TARGET"
        ADDITIONAL_TARGET="$ARM_TARGET"
        BUNDLE_DIR="target/$INTEL_TARGET/$TARGET_PROFILE_DIR/bundle/osx"
    elif [[ "$DEFAULT_ARCH" == *"$ARM_ARCH"* ]]; then
        echo "Default target is $ARM_TARGET"
        DEFAULT_TARGET="$ARM_TARGET"
        ADDITIONAL_TARGET="$INTEL_TARGET"
        BUNDLE_DIR="target/$ARM_TARGET/$TARGET_PROFILE_DIR/bundle/osx"
    fi
fi

# Set artifact-specific configuration.
if [[ "$ARTIFACT" == cli ]]; then
  UNIVERSAL_BINARY=false
  OPEN_AFTER_BUNDLE=false
  FEATURES="$FEATURES,standalone"
elif [[ "$ARTIFACT" == app ]]; then
  FEATURES="$FEATURES,gui,nld_improvements"
fi

# If we're building a universal bundle for the app artifact, make sure the additional target is available.
if [[ $UNIVERSAL_BINARY = true ]]; then
    rustup target add "$ADDITIONAL_TARGET"
fi

# If we only want to check that compilation will succeed, perform the checks
# then exit.  We use this script to invoke `cargo check` to ensure that we are
# using the same feature flags and profile that we would be using in production.
if [[ "$CHECK_ONLY" == "true" ]]; then
  cargo check --profile "$CARGO_PROFILE" --bin "$ASHIDE_BIN" --target "$DEFAULT_TARGET" --features "$FEATURES"
  if [[ $UNIVERSAL_BINARY = true && "$ARTIFACT" != "cli" ]]; then
    cargo check --profile "$CARGO_PROFILE" --bin "$ASHIDE_BIN" --target "$ADDITIONAL_TARGET" --features "$FEATURES"
  fi
  exit 0
fi

DMG_DIR="$BUNDLE_DIR/dmg/$ASHIDE_BIN"
DMG_NAME="$ASHIDE_APP_NAME.dmg"
if [[ -z "$FINAL_DMG_NAME" && -n "$DMG_NAME_SUFFIX" ]]; then
  FINAL_DMG_NAME="$ASHIDE_APP_NAME-$DMG_NAME_SUFFIX.dmg"
else
  FINAL_DMG_NAME="$ASHIDE_APP_NAME.dmg"
fi

# First clean up and prep the outdir
mkdir -p "$OUT_DIR"
rm -R "$OUT_DIR/$ASHIDE_APP_NAME.app" || echo "No old app to remove"
rm -R "$OUT_DIR/$FINAL_DMG_NAME" || echo "No old dmg to remove"

###########################
## Step 1: Build the app ##
###########################

if [[ "$ARTIFACT" == "app" ]]; then
  pushd app > /dev/null
  echo "Fetching the complete locked dependency graph before offline bundle assembly"
  cargo fetch --locked
  popd > /dev/null

  if [[ $BUILD_BINARY != true ]]; then
    echo "Skipping binary build due to --skip-build flag"
    export CARGO_BUNDLE_SKIP_BUILD=1
  else
    pushd app > /dev/null
    echo "Building $DEFAULT_TARGET for channel $RELEASE_CHANNEL with locked dependencies and profile $CARGO_PROFILE"
    cargo build --locked --profile "$CARGO_PROFILE" --bin "$ASHIDE_BIN" --target "$DEFAULT_TARGET" --features "$FEATURES"
    popd > /dev/null
    export CARGO_BUNDLE_SKIP_BUILD=1
  fi

  pushd app > /dev/null
  echo "Building and bundling $DEFAULT_TARGET for channel $RELEASE_CHANNEL and bundle id $BUNDLE_ID with profile $CARGO_PROFILE"
  # 二进制已经通过 --locked 完成构建；装配阶段只允许读取本地依赖图，禁止 cargo-bundle
  # 再次联网解析 registry，使发布结果依赖 crates.io 的即时可用性。
  CARGO_NET_OFFLINE=true cargo bundle --format osx --profile "$CARGO_PROFILE" --bin "$ASHIDE_BIN" --target "$DEFAULT_TARGET" --features "$FEATURES"
  popd > /dev/null
  normalize_cargo_bundle_app

  echo "Ensuring rpath support for mac frameworks"
  ensure_framework_rpath "$BUNDLE_DIR/$ASHIDE_APP_NAME.app/Contents/MacOS/$ASHIDE_BIN"

  export ASHIDE_SCHEME_NAME
  export ASHIDE_PLIST_PATH="$BUNDLE_DIR/$ASHIDE_APP_NAME.app/Contents/Info.plist"
  ./script/update_plist

  if [[ $REGISTER_SERVICES = true ]]; then
    plutil -insert NSServices -xml "
    <array>
      <dict>
        <key>NSMenuItem</key>
        <dict>
          <key>default</key>
          <string>New $ASHIDE_APP_NAME Tab Here</string>
        </dict>
        <key>NSMessage</key>
        <string>openTab</string>
        <key>NSRequiredContext</key>
        <dict>
          <key>NSTextContent</key>
          <string>FilePath</string>
        </dict>
        <key>NSSendTypes</key>
        <array>
          <string>NSFilenamesPboardType</string>
          <string>public.plain-text</string>
        </array>
      </dict>
      <dict>
        <key>NSMenuItem</key>
        <dict>
          <key>default</key>
          <string>New $ASHIDE_APP_NAME Window Here</string>
        </dict>
        <key>NSMessage</key>
        <string>openWindow</string>
        <key>NSRequiredContext</key>
        <dict>
          <key>NSTextContent</key>
          <string>FilePath</string>
        </dict>
        <key>NSSendTypes</key>
        <array>
          <string>NSFilenamesPboardType</string>
          <string>public.plain-text</string>
        </array>
      </dict>
    </array>" "$BUNDLE_DIR"/$ASHIDE_APP_NAME.app/Contents/Info.plist
  fi

  # Temporary key that ChatGPT Desktop can use to determine if the latest version of Ashide supports the ChatGPT integration.
  # Once support has been rolled out for a sufficient amount of time we (and ChatGPT) can remove this.
  plutil -insert SUPPORTS_CHAT_GPT_WORK_WITH_APPS -bool true "$BUNDLE_DIR"/$ASHIDE_APP_NAME.app/Contents/Info.plist

  # Add LSBackgroundOnly key and set it to false since we need a UI app
  plutil -insert LSBackgroundOnly -bool false "$BUNDLE_DIR"/$ASHIDE_APP_NAME.app/Contents/Info.plist

  # Add SMAuthorizedClients for macOS 13+ (Ventura) to support login item functionality
  plutil -insert SMAuthorizedClients -xml "<array><string>$BUNDLE_ID</string></array>" "$BUNDLE_DIR"/$ASHIDE_APP_NAME.app/Contents/Info.plist

  if [[ $UNIVERSAL_BINARY = true ]]; then
      if [[ $BUILD_BINARY = true ]]; then
          echo "Building $ADDITIONAL_TARGET to include in universal binary"

          pushd app > /dev/null
          cargo build --locked --profile "$CARGO_PROFILE" --bin "$ASHIDE_BIN" --target "$ADDITIONAL_TARGET" --features "$FEATURES"
          popd > /dev/null
      else
          echo "Skipping build of $ADDITIONAL_TARGET due to --skip-build flag"
      fi

      tmp_bundle_dir=$(mktemp -d -t ci-XXXXXXXXXX)

      echo "Ensuring rpath support for both binaries in universal executable"
      ensure_framework_rpath "target/$INTEL_TARGET/$TARGET_PROFILE_DIR/$ASHIDE_BIN"
      ensure_framework_rpath "target/$ARM_TARGET/$TARGET_PROFILE_DIR/$ASHIDE_BIN"

      echo "Building universal binary using lipo."
      lipo -create -output "$tmp_bundle_dir/$ASHIDE_BIN" \
          "target/$INTEL_TARGET/$TARGET_PROFILE_DIR/$ASHIDE_BIN" \
          "target/$ARM_TARGET/$TARGET_PROFILE_DIR/$ASHIDE_BIN"

      # Compute the real absolute path to the dSYM file, factoring in symlinks.
      # Starting in Rust 1.56, the generated dSYMs are symlinks to files within the target/dep directory. For example,
      # a dSYM for dev may be symlinked to target/deps/dev-080cf7e291fb066d.dSYM. This means the actual debug symbols are
      # would be located at dev.dSYM/Contents/Resources/DWARF/dev-080cf7e291fb066d.dSYM where dev.dSYM is symlink to
      # deps/dev-080cf7e291fb066d.dSYM. To fix this, parse out the actual name of the directory that the dSYM is
      # symlinked to, since this is also the name of file that contains the debug symbols within the dSYM.
      INTEL_DSYM_NAME=$(basename "$(realpath target/$INTEL_TARGET/$TARGET_PROFILE_DIR/$ASHIDE_BIN.dSYM)" .dSYM)
      INTEL_DSYM_PATH="target/$INTEL_TARGET/$TARGET_PROFILE_DIR/$ASHIDE_BIN.dSYM/Contents/Resources/DWARF/$INTEL_DSYM_NAME"
      ARM_DSYM_NAME=$(basename "$(realpath target/$ARM_TARGET/$TARGET_PROFILE_DIR/$ASHIDE_BIN.dSYM)" .dSYM)
      ARM_DSYM_PATH="target/$ARM_TARGET/$TARGET_PROFILE_DIR/$ASHIDE_BIN.dSYM/Contents/Resources/DWARF/$ARM_DSYM_NAME"
      if [[ -e "$INTEL_DSYM_PATH" && -e "$ARM_DSYM_PATH" ]]; then
        echo "Building universal binary .dSYM using lipo and storing in $OUT_DIR/$ASHIDE_BIN.dSYM"

        # Use lipo to merge the .dSYM files into a single universal .dSYM file.
        # It expects the base name for the file (with the .dSYM suffix removed).
        lipo -create -output "$OUT_DIR/$ASHIDE_BIN.dSYM" "${INTEL_DSYM_PATH}" "${ARM_DSYM_PATH}"
      fi

      echo "Storing result in $BUNDLE_DIR, replacing $DEFAULT_TARGET binary with fat binary."
      mv "$tmp_bundle_dir/$ASHIDE_BIN" "$BUNDLE_DIR/$ASHIDE_APP_NAME.app/Contents/MacOS"
  elif [[ -n "$TARGET_ARCH" && -e "target/$DEFAULT_TARGET/$TARGET_PROFILE_DIR/$ASHIDE_BIN.dSYM" ]]; then
    echo "Copying .dSYM into $OUT_DIR/$ASHIDE_BIN.dSYM"
    cp -HR "target/$DEFAULT_TARGET/$TARGET_PROFILE_DIR/$ASHIDE_BIN.dSYM" "$OUT_DIR/"
  fi

  BUNDLED_RESOURCES_DIR="$BUNDLE_DIR/$ASHIDE_APP_NAME.app/Contents/Resources"
  echo "Preparing bundled resources..."
  # Only forward --target to the schema generator when the build target is
  # runnable on the host; otherwise `cargo run` would try to execute a
  # cross-compiled binary and fail.
  if [[ "$DEFAULT_TARGET" == "$HOST_TARGET" ]]; then
    SCHEMA_CARGO_TARGET="$DEFAULT_TARGET"
  else
    SCHEMA_CARGO_TARGET=""
  fi
  "$WORKSPACE_ROOT_DIR/script/prepare_bundled_resources" "$BUNDLED_RESOURCES_DIR" "$RELEASE_CHANNEL" "$CARGO_PROFILE" "$FEATURES" "$SCHEMA_CARGO_TARGET"

  "$WORKSPACE_ROOT_DIR/script/compile_icon" "$ICON_ASSET_CHANNEL" "$BUNDLE_DIR/$ASHIDE_APP_NAME.app"

  HELPERS_DIR="$BUNDLE_DIR/$ASHIDE_APP_NAME.app/Contents/Helpers"
  if [[ ",$FEATURES," =~ ",heap_usage_tracking," ]]; then
    echo "Bundling pprof..."
    "$WORKSPACE_ROOT_DIR/script/prepare_bundled_pprof" "$HELPERS_DIR"
  fi

  # Determine CLI wrapper script path based on release channel.  Each channel's
  # value here must match `Channel::cli_command_name` in the Rust source.
  if [[ $RELEASE_CHANNEL = "stable" ]]; then
    CLI_SCRIPT_PATH="$BUNDLED_RESOURCES_DIR/bin/oz"
  elif [[ $RELEASE_CHANNEL = "oss" ]]; then
    CLI_SCRIPT_PATH="$BUNDLED_RESOURCES_DIR/bin/ashide"
  else
    CLI_SCRIPT_PATH="$BUNDLED_RESOURCES_DIR/bin/oz-$RELEASE_CHANNEL"
  fi

  echo "Creating Resources/bin directory and CLI wrapper script..."
  mkdir -p "$BUNDLED_RESOURCES_DIR/bin"
  
  cat > "$CLI_SCRIPT_PATH" << 'EOF'
#!/bin/bash
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec -a "$0" "$script_dir/../../MacOS/ASHIDE_BIN_PLACEHOLDER" "$@"
EOF
  
  # Replace the placeholder with the actual binary name
  sed -i '' "s/ASHIDE_BIN_PLACEHOLDER/$ASHIDE_BIN/" "$CLI_SCRIPT_PATH"
  
  # Make the script executable
  chmod +x "$CLI_SCRIPT_PATH"

  # 校验 cargo-bundle 的最终产物，而不是只检查不会进入主 App 的模板 plist。
  assert_app_bundle_plist_contract

  # Store the built artifact locations for GitHub Actions outputs.
  BINARY_PATH="target/$DEFAULT_TARGET/$TARGET_PROFILE_DIR/$ASHIDE_BIN"
  DMG_PATH="$OUT_DIR/$FINAL_DMG_NAME"
elif [[ "$ARTIFACT" == "cli" ]]; then
  if [[ $BUILD_BINARY == true ]]; then
    # Create Info.plist before building the app, since it's embedded at build time.
    # Apple's codesigning tools will detect Info.plist files in the same directory as an executable.
    # This breaks the code signature, so we must use a different location for the file.
    mkdir -p "$BUNDLE_DIR"
    export ASHIDE_PLIST_PATH="$BUNDLE_DIR/cli-info.plist"
    cp app/assets/resources/mac/CLI-Info.plist "$ASHIDE_PLIST_PATH"

    export ASHIDE_PLIST_NO_FILE_TYPES=true
    ./script/update_plist
    plutil -insert CFBundleIdentifier -string "$BUNDLE_ID" "$ASHIDE_PLIST_PATH"
    plutil -insert CFBundleName -string "$ASHIDE_BIN" "$ASHIDE_PLIST_PATH"
    plutil -insert CFBundleExecutable -string "$ASHIDE_BIN" "$ASHIDE_PLIST_PATH"

    export "INFO_PLIST_PATH=$(realpath "$ASHIDE_PLIST_PATH")"
    pushd app > /dev/null
    echo "Building $DEFAULT_TARGET for channel $RELEASE_CHANNEL with profile $CARGO_PROFILE"
    cargo build --locked --profile "$CARGO_PROFILE" --bin "$ASHIDE_BIN" --target "$DEFAULT_TARGET" --features "$FEATURES"
    popd > /dev/null
  else
    echo "Skipping binary build due to --skip-build flag"
  fi

  echo "Copying binary into $OUT_DIR/$ASHIDE_BIN"
  cp "target/$DEFAULT_TARGET/$TARGET_PROFILE_DIR/$ASHIDE_BIN" "$OUT_DIR/$ASHIDE_BIN"

  if [[ -n "$TARGET_ARCH" && -e "target/$DEFAULT_TARGET/$TARGET_PROFILE_DIR/$ASHIDE_BIN.dSYM" ]]; then
    echo "Copying .dSYM into $OUT_DIR/$ASHIDE_BIN.dSYM"
    cp -HR "target/$DEFAULT_TARGET/$TARGET_PROFILE_DIR/$ASHIDE_BIN.dSYM" "$OUT_DIR/"
  fi

  echo "Preparing CLI resources directory"
  BUNDLED_RESOURCES_DIR="$OUT_DIR/resources"
  # Only forward --target to the schema generator when the build target is
  # runnable on the host; otherwise `cargo run` would try to execute a
  # cross-compiled binary and fail.
  if [[ "$DEFAULT_TARGET" == "$HOST_TARGET" ]]; then
    SCHEMA_CARGO_TARGET="$DEFAULT_TARGET"
  else
    SCHEMA_CARGO_TARGET=""
  fi
  "$WORKSPACE_ROOT_DIR/script/prepare_bundled_resources" "$BUNDLED_RESOURCES_DIR" "$RELEASE_CHANNEL" "$CARGO_PROFILE" "$FEATURES" "$SCHEMA_CARGO_TARGET"


  # Set the primary binary path to output.
  BINARY_PATH="$OUT_DIR/$ASHIDE_BIN"
else
  echo "Unsupported artifact: $ARTIFACT" >&2
  exit 1
fi

##########################################
## Step 2: Create code-signing keychain ##
##########################################

if [[ $READ_PASSWORDS_FROM_ENV != true ]]; then
  echo "Skipping code-signing because passwords are not available in environment."
  CODESIGN=false
fi

if [[ $CODESIGN = true ]]; then
  CODESIGN_KEYCHAIN_NAME="warp-codesign-keychain"

  echo "Starting codesigning..."

  security delete-keychain $CODESIGN_KEYCHAIN_NAME || echo "No existing keychain to clean up".

  echo "Creating $CODESIGN_KEYCHAIN_NAME keychain."
  security create-keychain -p "$ASHIDE_CODESIGN_KEYCHAIN_PASSWORD" $CODESIGN_KEYCHAIN_NAME
  security list-keychains -s $CODESIGN_KEYCHAIN_NAME
  security set-keychain-settings -t 3600 -u $CODESIGN_KEYCHAIN_NAME

  echo "Unlocking keychain and setting cert."
  security unlock-keychain -p "$ASHIDE_CODESIGN_KEYCHAIN_PASSWORD" $CODESIGN_KEYCHAIN_NAME
  security import <(echo "$ASHIDE_DEVELOPER_ID_CERT" | base64 -d) -f pkcs12 -P "$ASHIDE_DEVELOPER_ID_CERT_PASSWORD" -k $CODESIGN_KEYCHAIN_NAME -T /usr/bin/codesign
  security set-key-partition-list -S "apple-tool:,apple:" -s -k "$ASHIDE_CODESIGN_KEYCHAIN_PASSWORD" $CODESIGN_KEYCHAIN_NAME

  DEVELOPER_ID_IDENTITIES="$(security find-identity -v -p codesigning "$CODESIGN_KEYCHAIN_NAME" | awk '/Developer ID Application:/')"
  DEVELOPER_ID_IDENTITY_COUNT="$(grep -c . <<<"$DEVELOPER_ID_IDENTITIES" || true)"
  if [[ "$DEVELOPER_ID_IDENTITY_COUNT" -ne 1 ]]; then
    echo "Imported certificate must contain exactly one Developer ID Application: signing identity; found $DEVELOPER_ID_IDENTITY_COUNT" >&2
    exit 1
  fi
  if ! grep -Fq "($ASHIDE_NOTARIZATION_TEAM_ID)" <<<"$DEVELOPER_ID_IDENTITIES"; then
    echo "Developer ID Application identity does not belong to ASHIDE_NOTARIZATION_TEAM_ID" >&2
    exit 1
  fi
  SIGNING_IDENTITY="$(awk '{print $2}' <<<"$DEVELOPER_ID_IDENTITIES")"
fi

##############################
## Step 3: Codesign the app ##
##############################

if [[ $SELFSIGN = true ]]; then
  SIGNING_CERT="$(security find-identity -p codesigning -v | grep "Apple Development" | awk '{print $2}' | head -1)"
  if [[ -z "$SIGNING_CERT" ]]; then
    echo "No Apple Development cert found, falling back to ad-hoc signing."
    SIGNING_CERT="-"
  else
    echo "Found Apple Development certificate"
  fi
  if [[ "$ARTIFACT" == app ]]; then
    echo "Self-signing $BUNDLE_DIR/$ASHIDE_APP_NAME.app with ${SIGNING_CERT}..."
    codesign --force --deep --options runtime --sign "$SIGNING_CERT" "$BUNDLE_DIR/$ASHIDE_APP_NAME.app" --entitlements script/Debug-Entitlements.plist
  elif [[ "$ARTIFACT" == cli ]]; then
    echo "Self-signing $OUT_DIR/$ASHIDE_BIN with ${SIGNING_CERT}..."
    codesign --force --options runtime --sign "$SIGNING_CERT" "$OUT_DIR/$ASHIDE_BIN" --entitlements script/Debug-Entitlements.plist
  fi
elif [[ $CODESIGN = true ]]; then
  if [[ "$ARTIFACT" == app ]]; then
    echo "Codesigning $BUNDLE_DIR/$ASHIDE_APP_NAME.app..."
    # Use --deep so we sign bundled frameworks as well
    codesign --deep -f -o runtime --timestamp --keychain "$CODESIGN_KEYCHAIN_NAME" -s "$SIGNING_IDENTITY" "$BUNDLE_DIR/$ASHIDE_APP_NAME.app" --entitlements script/Entitlements.plist
  elif [[ "$ARTIFACT" == cli ]]; then
    echo "Codesigning $OUT_DIR/$ASHIDE_BIN..."
    codesign -f -o runtime --timestamp --keychain "$CODESIGN_KEYCHAIN_NAME" -s "$SIGNING_IDENTITY" "$OUT_DIR/$ASHIDE_BIN" --entitlements script/Entitlements.plist

    # Create the .zip for notarization in a separate location - otherwise, Apple's codesigning
    # tools decide that it's a sealed resource that belongs to the binary and needs to also be signed.
    NOTARIZATION_ARTIFACT="$BUNDLE_DIR/${ASHIDE_BIN}_notarize.zip"
    if [[ -e "$NOTARIZATION_ARTIFACT" ]]; then
      echo "Removing old notarization artifact..."
      rm "$NOTARIZATION_ARTIFACT"
    fi

    # Create a .zip archive to notarize.
    ditto -c -k "$OUT_DIR/$ASHIDE_BIN" "$NOTARIZATION_ARTIFACT"
    
    # It's not possible to staple notarization tickets to standalone binaries:
    # https://developer.apple.com/documentation/security/customizing-the-notarization-workflow?language=objc#Staple-the-ticket-to-your-distribution
    STAPLE_TICKET=false
  fi
fi

if [[ "$ARTIFACT" == app ]]; then
  seal_and_verify_app_bundle
fi

########################
## Step 4: Create DMG ##
########################

if [[ "$ARTIFACT" = app ]]; then
  echo "Creating $DMG_DIR/$DMG_NAME with the repository-owned diskutil image pipeline..."
  rm -rf "$DMG_DIR"
  mkdir -p "$DMG_DIR"

  "$WORKSPACE_ROOT_DIR/script/macos/create_ashide_dmg" \
    "$BUNDLE_DIR/$ASHIDE_APP_NAME.app" \
    "$DMG_DIR/$DMG_NAME" \
    "$WORKSPACE_ROOT_DIR/app/assets/resources/mac/ashide_install_image.png"

  if [[ $CODESIGN = true ]]; then
    echo "Codesigning $DMG_DIR/$DMG_NAME..."
    codesign --keychain "$CODESIGN_KEYCHAIN_NAME" -s "$SIGNING_IDENTITY" --timestamp "$DMG_DIR/$DMG_NAME"

    NOTARIZATION_ARTIFACT="$DMG_DIR/$DMG_NAME"
    STAPLE_TICKET=true
  fi
fi

##############################
## Step 5: Notarize the app ##
##############################

if [[ $CODESIGN = true ]]; then
  echo "Uploading $NOTARIZATION_ARTIFACT to Apple for notarization..."
  xcrun notarytool submit "$NOTARIZATION_ARTIFACT" --apple-id "$ASHIDE_NOTARIZATION_APPLE_ID" --password "$ASHIDE_NOTARIZATION_PASSWORD" --team-id "$ASHIDE_NOTARIZATION_TEAM_ID" --wait

  if [[ $STAPLE_TICKET = true ]]; then
    echo "Attempting to staple the notarization ticket to $NOTARIZATION_ARTIFACT..."
    xcrun stapler staple "$NOTARIZATION_ARTIFACT"
  fi

  if [[ $? != 0 ]]; then
    echo "Notarization failed; see above output for details."
    exit 1
  fi

  # Verify the notarization results (this is format-dependent)
  echo "Verifying notarization ticket..."
  if [[ "$ARTIFACT" = app ]]; then
    xcrun stapler validate "$DMG_DIR/$DMG_NAME"
  elif [[ "$ARTIFACT" = cli ]]; then
    spctl -a -t open --context context:primary-signature -vv "$OUT_DIR/$ASHIDE_BIN"
  fi
fi

if [[ "$ARTIFACT" == "app" && "$DISTRIBUTION" == "public" ]]; then
  "$WORKSPACE_ROOT_DIR/script/macos/verify_public_distribution" \
    "$BUNDLE_DIR/$ASHIDE_APP_NAME.app" \
    "$DMG_DIR/$DMG_NAME" \
    "$ASHIDE_NOTARIZATION_TEAM_ID"
fi


#######################################
## Step 6: Copy and output artifacts ##
#######################################

if [[ "$ARTIFACT" = app ]]; then
  echo "Copying dmg and app to $OUT_DIR"
  cp -R "$BUNDLE_DIR/$ASHIDE_APP_NAME.app" "$OUT_DIR"
  cp "$DMG_DIR/$DMG_NAME" "$OUT_DIR/$FINAL_DMG_NAME"
fi

# If this is being run within a GitHub action, set an output variable with the
# location of the artifacts so they can be referenced by subsequent actions.
if [ "${GITHUB_ACTIONS}" == "true" ]; then
  echo "::echo::on"

  # For individual architecture builds, output binary information
  if [[ -n "$TARGET_ARCH" ]]; then
    echo "binary_path=$BINARY_PATH" >> "$GITHUB_OUTPUT"
    echo "target_arch=$TARGET_ARCH" >> "$GITHUB_OUTPUT"
    echo "rust_target=$DEFAULT_TARGET" >> "$GITHUB_OUTPUT"
    
    # If the dSYM is available, output both its path and its realpath.
    # The realpath is needed because the dSYM is a symlink, and when preserving
    # the build artifacts, we want to preserve both the symlink and its target.
    DSYM_PATH="${BINARY_PATH}.dSYM"
    if [[ -d "$DSYM_PATH" ]]; then
      echo "dsym_path=$DSYM_PATH" >> "$GITHUB_OUTPUT"

      # If the dSYM is a symlink, output its real path.
      if [[ -L "$DSYM_PATH" ]]; then
        echo "dsym_realpath=$(relpath $(realpath $DSYM_PATH))" >> "$GITHUB_OUTPUT"
      fi
    fi
  fi

  echo "frameworks_dir=app/frameworks/${FRAMEWORK_OVERRIDE:-default}" >> "$GITHUB_OUTPUT"
  
  # For full bundles, output DMG information
  if [[ -f "$OUT_DIR/$FINAL_DMG_NAME" ]]; then
    echo "dmg_name=$FINAL_DMG_NAME" >> "$GITHUB_OUTPUT"
    echo "dmg_path=$DMG_PATH" >> "$GITHUB_OUTPUT"
    echo "dsym_folder_path=$OUT_DIR" >> "$GITHUB_OUTPUT"
  fi

  if [[ -n "$BUNDLED_RESOURCES_DIR" ]]; then
    echo "bundled_resources_dir=$BUNDLED_RESOURCES_DIR" >> "$GITHUB_OUTPUT"
  fi
  
  echo "::echo::off"
fi

if [[ $OPEN_AFTER_BUNDLE = true ]]; then
    open "$OUT_DIR"
fi
