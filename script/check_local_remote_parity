}

jcode_internal_wire_references() {
    python3 - <<'PY'
import re
from pathlib import Path

wire_pattern = re.compile(
    r'jcode_(?:app_core|protocol)|"type"\s*:\s*"(?:subscribe|resume_session|message|cancel)"',
    re.IGNORECASE,
)
for root in (Path("app/src"), Path("crates")):
    for path in root.rglob("*.rs"):
        if path.name.endswith(("_test.rs", "_tests.rs")) or "tests" in path.parts:
            continue
        text = path.read_text().split("\n#[cfg(test)]", maxsplit=1)[0]
        if "jcode" not in text.lower():
            continue
        for line_number, line in enumerate(text.splitlines(), start=1):
            if wire_pattern.search(line):
                print(f"{path}:{line_number}:{line}")
PY
}

