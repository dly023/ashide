if ! python3 - <<'PY'
import re
from pathlib import Path

def function_body(path, name):
    text = Path(path).read_text()
    match = re.search(
        rf"(?m)^\s*(?:pub(?:\([^)]*\))?\s+)?fn\s+{re.escape(name)}\s*\(",
        text,
    )
    if match is None:
        raise SystemExit(f"missing function {path}:{name}")
    brace = text.index("{", match.end())
    depth = 0
    for index in range(brace, len(text)):
        if text[index] == "{":
            depth += 1
        elif text[index] == "}":
            depth -= 1
            if depth == 0:
                return text[match.start():index + 1]
    raise SystemExit(f"unterminated function {path}:{name}")

navigator = function_body(
    "app/src/workspace/view/session_navigator.rs", "live_workspace_sessions"
)
for forbidden in [
    "CLIAgentSessionsModel::as_ref",
    "apply_registered_cli_agent_session_to_live_snapshot",
    "custom_command_prefix",
    ".command_prefix()",
]:
    if forbidden in navigator:
        raise SystemExit(
            f"live_workspace_sessions contains forbidden provider reconstruction: {forbidden}"
        )
if "session_binding_for_pane_id" not in navigator:
    raise SystemExit("runtime placeholder projection must read PaneConfiguration.session_binding")

handler = function_body(
    "app/src/workspace/view/session_navigator.rs", "handle_cli_agent_sessions_event"
)
for required in [
    "CLIAgentSessionsModelEvent::Started",
    "CLIAgentSessionsModelEvent::SessionUpdated",
    "refresh_terminal_pane_session_binding",
    'ctx.dispatch_global_action("workspace:save_app", ())',
]:
    if required not in handler:
        raise SystemExit(f"binding lifecycle handler is missing: {required}")
PY
