    raise SystemExit("shared Environment helper must use the saved-provider node id")
if "ssh-config:" in helper or "load_candidates" in helper:
    raise SystemExit("shared Environment helper must not read developer SSH config")
PY
then
    echo "[LR-157] Workspace Environment test fixture is not hermetic" >&2
    fail=1
fi

