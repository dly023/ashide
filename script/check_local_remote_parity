if ! python3 - <<'PY'
import re
from pathlib import Path


def function_body(path, name):
    text = Path(path).read_text()
    match = re.search(rf"(?m)^\s*(?:pub(?:\([^)]*\))?\s+)?fn\s+{re.escape(name)}\s*\(", text)
    if not match:
        raise SystemExit(f"missing function {path}:{name}")
    brace = text.find("{", match.end())
    if brace < 0:
        raise SystemExit(f"missing body {path}:{name}")
    depth = 0
    for index in range(brace, len(text)):
        if text[index] == "{":
            depth += 1
        elif text[index] == "}":
            depth -= 1
            if depth == 0:
                return text[match.start():index + 1]
    raise SystemExit(f"unterminated function {path}:{name}")

resolver = function_body(
    "app/src/workspace/view/vertical_tabs.rs", "live_cli_agent_activity_indicator"
)
for required in [
    "session.is_live_container()",
    ".container_uuid",
    "terminal_view_id_for_container_uuid",
    "CLIAgentSessionsModel::as_ref",
    "session_supports_rich_status",
    "cli_agent_session.agent != expected_agent",
    "restored_session_activity_indicator",
]:
    if required not in resolver:
        raise SystemExit(f"live activity resolver is missing: {required}")
for forbidden in [
    "locator_from_restored_session_id",
    "session.id",
    "updated_at_unix_ms",
    "cli_agent_session_id",
    "command_prefix",
]:
    if forbidden in resolver:
        raise SystemExit(f"live activity resolver must not infer status from: {forbidden}")

badge = function_body(
    "app/src/workspace/view/vertical_tabs.rs", "restored_session_icon_badge"
)
if badge.find("RestoredSessionIconBadge::Resuming") > badge.find("activity_indicator.map"):
    raise SystemExit("resume spinner must take precedence over activity badge")

lookup = function_body(
    "app/src/pane_group/mod.rs", "terminal_view_id_for_container_uuid"
)
for required in ["container_uuid", "downcast_pane_by_id::<TerminalPane>", "terminal_view(app).id()"]:
    if required not in lookup:
        raise SystemExit(f"container activity carrier lookup is missing: {required}")
if "find_pane_id_for_terminal_view" in lookup:
    raise SystemExit("container activity lookup must not reverse-resolve a runtime EntityId")

handler = function_body(
    "app/src/workspace/view/session_navigator.rs", "handle_cli_agent_sessions_event"
)
if "CLIAgentSessionsModelEvent::StatusChanged" not in handler:
    raise SystemExit("Workspace must refresh Navigator on CLI agent status changes")
PY
then
    echo "[LR-185] Session Navigator live CLI agent activity ownership changed" >&2
    fail=1
fi

