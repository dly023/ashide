import re
from pathlib import Path

text = Path("app/src/workspace/view.rs").read_text()

def function_body(name):
    match = re.search(rf"(?m)^\s*fn\s+{re.escape(name)}\s*\(", text)
    if match is None:
        raise SystemExit(f"missing Workspace function: {name}")
    brace = text.index("{", match.end())
    depth = 0
    for index in range(brace, len(text)):
        if text[index] == "{":
            depth += 1
        elif text[index] == "}":
            depth -= 1
            if depth == 0:
                return text[brace : index + 1]
    raise SystemExit(f"unterminated Workspace function: {name}")

