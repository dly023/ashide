# LR-063: tracker 的 capability_matrix 引用必须对应唯一 CSV capability 行。
require_contract_marker "LR-063" "LR-PARITY-TRACKER-MATRIX-REF-01" docs/LOCAL_REMOTE_PARITY_SPEC.yaml
require_contract_marker "LR-063" "id: LR-063" docs/design/local-remote-parity-tracker.yaml
require_contract_marker "LR-063" "engineering guard: tracker matrix referential integrity" docs/design/local-remote-capability-matrix.csv
require_contract_marker "LR-063" "tracker_capability_matrix_references_are_complete" app/src/remote_server/dev_remote_install.rs

tracker_capabilities=$(sed -n 's/^    capability_matrix: "\(.*\)"$/\1/p' docs/design/local-remote-parity-tracker.yaml)
matrix_capabilities=$(tail -n +2 docs/design/local-remote-capability-matrix.csv | cut -d, -f1)
while IFS= read -r capability; do
    if [[ -n "$capability" ]] && ! grep -Fqx "$capability" <<<"$matrix_capabilities"; then
        echo "[LR-063] tracker capability_matrix reference has no matrix row: $capability" >&2
        fail=1
    fi
done <<<"$tracker_capabilities"

duplicate_matrix_capabilities=$(printf '%s\n' "$matrix_capabilities" | sort | uniq -d)
if [[ -n "$duplicate_matrix_capabilities" ]]; then
    echo "[LR-063] capability matrix contains duplicate capability rows" >&2
    echo "$duplicate_matrix_capabilities" >&2
    fail=1
fi

