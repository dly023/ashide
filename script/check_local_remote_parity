#!/bin/bash

set -euo pipefail
cd "$(dirname "$0")/.."

# LR-096: fail once with a precise toolchain error instead of turning a missing
# search/parser dependency into hundreds of false contract violations.
required_commands=(rg python3)
for required_command in "${required_commands[@]}"; do
    if ! command -v "$required_command" >/dev/null 2>&1; then
        echo "local/remote parity checker requires '$required_command'; install the declared Linux build dependencies first" >&2
        exit 1
    fi
done

fail=0

if ! ./scripts/check_i18n_orphans.sh; then
    echo "[i18n] Fluent owner inventory is incomplete" >&2
    fail=1
fi

rust_production_call_sites() {
    local pattern="$1"

    rg -n \
        --glob '*.rs' \
        --glob '!**/*_test.rs' \
        --glob '!**/*_tests.rs' \
        --glob '!**/tests/**' \
        "$pattern" \
        app/src crates \
        || true
}

rust_production_callsite_owners() {
    local pattern="$1"

    python3 - "$pattern" <<'PY'
import re
import sys
from pathlib import Path

pattern = re.compile(sys.argv[1])
function_pattern = re.compile(
    r"\bfn\s+([A-Za-z_][A-Za-z0-9_]*)\s*(?:<[^\n>{};()]*>)?\s*\("
)

for root in (Path("app/src"), Path("crates")):
    for path in sorted(root.rglob("*.rs")):
        if "tests" in path.parts or path.name.endswith(("_test.rs", "_tests.rs")):
            continue
        text = path.read_text(errors="replace")
        cfg_test = re.search(r"(?m)^\s*#\[cfg\(test\)\]\s*\n\s*mod\s+tests\s*\{", text)
        if cfg_test:
            text = text[:cfg_test.start()]
        lines = text.splitlines()
        for line_index, line in enumerate(lines):
            for _ in pattern.finditer(line):
                for owner_line in range(line_index, -1, -1):
                    match = function_pattern.search(lines[owner_line])
                    if match:
                        print(f"{path}:{match.group(1)}")
                        break
                else:
                    print(f"{path}:<no-enclosing-function>")
PY
}

rust_production_call_sites_without_inline_tests() {
    local pattern="$1"

    python3 - "$pattern" <<'PY'
import re
import sys
from pathlib import Path

pattern = re.compile(sys.argv[1])
for root in (Path("app/src"), Path("crates")):
    for path in sorted(root.rglob("*.rs")):
        if "tests" in path.parts or path.name.endswith(("_test.rs", "_tests.rs")):
            continue
        text = path.read_text(errors="replace")
        cfg_test = re.search(r"(?m)^\s*#\[cfg\(test\)\]\s*\n\s*mod\s+tests\s*\{", text)
        if cfg_test:
            text = text[:cfg_test.start()]
        for line_number, line in enumerate(text.splitlines(), start=1):
            if pattern.search(line):
                print(f"{path}:{line_number}:{line}")
PY
}

require_rust_callsite_owners() {
    local contract_id="$1"
    local description="$2"
    local pattern="$3"
    local expected="$4"
    local actual

    actual=$(rust_production_callsite_owners "$pattern")
    if [[ "$actual" != "$expected" ]]; then
        echo "[$contract_id] $description caller ownership changed; classify the new owner instead of relying on a stable count" >&2
        echo "expected:" >&2
        echo "$expected" >&2
        echo "actual:" >&2
        echo "$actual" >&2
        fail=1
    fi
}

rust_workspace_split_binding_inventory() {
    python3 <<'PY'
import re
from pathlib import Path

binding_pattern = re.compile(
    r'EditableBinding::new\s*\(\s*"(?P<descriptor>pane_group:add_(?:left|right|up|down))"'
)
function_pattern = re.compile(
    r"\bfn\s+([A-Za-z_][A-Za-z0-9_]*)\s*(?:<[^\n>{};()]*>)?\s*\("
)

for root in (Path("app/src"), Path("crates")):
    for path in sorted(root.rglob("*.rs")):
        if "tests" in path.parts or path.name.endswith(("_test.rs", "_tests.rs")):
            continue
        text = path.read_text(errors="replace")
        for binding in binding_pattern.finditer(text):
            owner_matches = list(function_pattern.finditer(text, 0, binding.start()))
            owner = owner_matches[-1].group(1) if owner_matches else "<no-enclosing-function>"
            line = text.count("\n", 0, binding.start()) + 1
            print(f"{path}:{line}:{owner}:{binding.group('descriptor')}")
PY
}

rust_workspace_split_binding_owners() {
    rust_workspace_split_binding_inventory \
        | sed -E 's/^([^:]+):[0-9]+:/\1:/' \
        | LC_ALL=C sort
}

require_workspace_split_binding_owners() {
    local expected="$1"
    local actual

    actual=$(rust_workspace_split_binding_owners)
    if [[ "$actual" != "$expected" ]]; then
        echo "[LR-149] workspace split descriptor registration ownership changed; every production binding must remain exclusively owned by workspace::init" >&2
        echo "expected owners:" >&2
        echo "$expected" >&2
        echo "actual inventory (path:line:owner:descriptor):" >&2
        rust_workspace_split_binding_inventory >&2
        fail=1
    fi
}

