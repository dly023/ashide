from pathlib import Path

path = Path("app/src/workspace/view_test.rs")
text = path.read_text()

def function_body(name: str) -> str:
    marker = f"fn {name}("
    start = text.find(marker)
    if start < 0:
        raise SystemExit(f"missing function {name}")
    brace = text.find("{", start)
    if brace < 0:
        raise SystemExit(f"missing body for {name}")
    depth = 0
    for index in range(brace, len(text)):
        char = text[index]
        if char == "{":
            depth += 1
        elif char == "}":
            depth -= 1
            if depth == 0:
                return text[brace:index + 1]
    raise SystemExit(f"unterminated body for {name}")

initializer = function_body("ensure_test_ssh_manager_database_migrated")
helper = function_body("test_ssh_server_for_environment_tests")

