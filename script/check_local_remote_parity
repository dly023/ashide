require_contract_marker "LR-040" "BEGIN REQUIRED_RESULT_RESPONSE_VARIANTS" crates/remote_server/src/client/mod.rs
require_contract_marker "LR-040" "required_result_response_names_match_proto_contract" crates/remote_server/src/client_tests.rs
require_contract_marker "LR-040" "all_required_result_responses_reject_missing_result" crates/remote_server/src/client_tests.rs

required_result_responses=$(awk '
    /^message [A-Za-z0-9]+Response \{/ { response = $2; in_response = 1; next }
    in_response && /^[[:space:]]+oneof result \{/ { print response; in_response = 0 }
' crates/remote_server/proto/remote_server.proto)
validator_block=$(sed -n '/BEGIN REQUIRED_RESULT_RESPONSE_VARIANTS/,/END REQUIRED_RESULT_RESPONSE_VARIANTS/p' crates/remote_server/src/client/mod.rs)
while IFS= read -r response; do
    [[ -z "$response" ]] && continue
    if ! grep -q --fixed-strings "Message::$response(" <<<"$validator_block"; then
        echo "[LR-040] required-result response missing from transport validator: $response" >&2
        fail=1
    fi
done <<<"$required_result_responses"

false_success_matches=$(rg -n -U '\|[[:space:]]*None[[:space:]]*=>' \
    crates/remote_server/src/client/mod.rs \
    app/src/workspace/environment_runtime.rs || true)
if [[ -n "$false_success_matches" ]]; then
    echo "[LR-040] application code must not merge missing result with a domain outcome" >&2
    echo "$false_success_matches" >&2
    fail=1
fi

pty_empty_domain_matches=$(rg -n 'EnvironmentRuntimePtyCreateResult::Empty|^[[:space:]]*Empty,$' \
    app/src/workspace/environment_runtime.rs \
    app/src/terminal/remote_tty/event_loop.rs || true)
if [[ -n "$pty_empty_domain_matches" ]]; then
    echo "[LR-040] missing CreatePty result must stay a protocol error, not a domain state" >&2
    echo "$pty_empty_domain_matches" >&2
    fail=1
fi

