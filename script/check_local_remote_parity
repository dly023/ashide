def method_body(name):
    start = view.index(f"    fn {name}")
    next_method = re.search(r"\n    fn [A-Za-z_][A-Za-z0-9_]*", view[start + 1:])
    end = start + 1 + next_method.start() if next_method else len(view)
    return view[start:end]

for method in [
    "render_environment_provider_picker_popover",
    "open_environment_provider_candidate",
    "reconnect_environment_runtime_authority",
]:
    body = method_body(method)
    for forbidden in [
        "load_candidates(",
        "load_provider_candidates(",
        "dirs::home_dir",
        "~/.ssh/config",
        "std::fs",
        "is_local",
        "is_remote",
        "EnvironmentKind::Local",
        "EnvironmentKind::Remote",
        "target_os",
    ]:
        if forbidden in body:
            raise SystemExit(
                f"Workspace provider method {method} contains forbidden source/platform branch: {forbidden}"
            )

render_body = method_body("render_environment_provider_picker_popover")
if "config_open_target" not in render_body:
    raise SystemExit("Workspace provider render must consume catalog-owned config_open_target")

source = Path("app/src/workspace/environment_provider/source_saved_ssh.rs").read_text()
if "warp_ssh_manager::load_candidates" in source:
    raise SystemExit("environment provider runtime lookup still reloads SSH config from disk")
if "&SshTargetCatalog" not in source:
    raise SystemExit("environment provider runtime lookup must consume the shared catalog")
PY
then
    echo "[LR-164] Workspace provider projection/runtime lookup does not share the committed SSH config catalog" >&2
    fail=1
fi

