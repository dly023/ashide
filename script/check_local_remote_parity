# LR-166: command ownership takeover cancels, but never forges, an OSC End.
require_contract_marker "LR-166" "TERMINAL-IN-BAND-GENERATOR-CANCEL-70" docs/LOCAL_REMOTE_PARITY_SPEC.yaml
require_contract_marker "LR-166" "id: LR-166" docs/design/local-remote-parity-tracker.yaml
require_contract_marker "LR-166" "Terminal in-band generator: protocol completion versus command cancellation" docs/design/local-remote-capability-matrix.csv
require_contract_marker "LR-166" "Self::take_command_output_ownership(&mut model, source);" app/src/terminal/writeable_pty/pty_controller.rs
require_rust_test_name "LR-166" "write_command_takeover_is_idle_no_op_with_zero_error_events" app/src/terminal/model/terminal_model_test.rs
require_rust_test_name "LR-166" "write_command_takeover_discards_partial_payload_with_zero_error_events" app/src/terminal/model/terminal_model_test.rs
lr166_inventory=$(python3 <<'PY'
import re
from pathlib import Path

patterns = {
    "end": re.compile(r"\.end_in_band_command_output\s*\("),
    "cancel": re.compile(r"\.cancel_in_band_command_output\s*\("),
    "takeover": re.compile(r"\b(?:Self|PtyController(?:::[^\s(]+)?)::take_command_output_ownership\s*\("),
}
function_pattern = re.compile(r"\bfn\s+([A-Za-z_][A-Za-z0-9_]*)\s*(?:<[^\n>{};()]*>)?\s*\(")
for root in (Path("app/src"), Path("crates")):
    for path in sorted(root.rglob("*.rs")):
        if "tests" in path.parts or path.name.endswith(("_test.rs", "_tests.rs")):
            continue
        lines = path.read_text(errors="replace").splitlines()
        for index, line in enumerate(lines):
            for kind, pattern in patterns.items():
                if not pattern.search(line):
                    continue
                owner = "<no-enclosing-function>"
                for owner_line in range(index, -1, -1):
                    match = function_pattern.search(lines[owner_line])
                    if match:
                        owner = match.group(1)
                        break
                print(f"{kind}:{path}:{index + 1}:{owner}:{line.strip()}")
PY
)
echo "[LR-166] End/cancel/takeover production inventory (kind:path:line:enclosing-function:source):"
echo "$lr166_inventory"
lr166_owners=$(echo "$lr166_inventory" | sed -E 's/^([^:]+):([^:]+):[0-9]+:([^:]+):.*$/\1:\2:\3/' | LC_ALL=C sort)
lr166_expected_owners=$(cat <<'EOF'
cancel:app/src/terminal/writeable_pty/pty_controller.rs:take_command_output_ownership
end:app/src/terminal/model/ansi/mod.rs:unhandled
takeover:app/src/terminal/writeable_pty/pty_controller.rs:write_command
EOF
)
if [[ "$lr166_owners" != "$lr166_expected_owners" ]]; then
    echo "[LR-166] End/cancel/takeover owner or wrapper inventory changed; only the ANSI parser may own End and write_command must use the unique takeover wrapper" >&2
    echo "expected:" >&2
    echo "$lr166_expected_owners" >&2
    echo "actual:" >&2
    echo "$lr166_owners" >&2
    fail=1
fi

