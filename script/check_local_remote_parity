require_contract_marker "LR-098" "SFTP-ATOMIC-STAGING-04" docs/LOCAL_REMOTE_PARITY_SPEC.yaml
require_contract_marker "LR-098" "id: LR-098" docs/design/local-remote-parity-tracker.yaml
