    rust_production_callsite_owners 'session control|JcodeRealtime|jcode_realtime'
    echo
    echo 'Jcode internal wire references in Jcode-owning production sources (must remain empty):'
    jcode_internal_wire_references
}

check_completion_gate() {
    local tracker_path="$1"
    local capability_matrix_path="$2"
    local diagnostics

    if diagnostics=$(python3 - "$tracker_path" "$capability_matrix_path" <<'PY'
import csv
import re
import sys
from pathlib import Path

tracker_path = Path(sys.argv[1])
capability_matrix_path = Path(sys.argv[2])
errors = []

tracker_lines = tracker_path.read_text().splitlines()
item_starts = [
    (index, match.group(1))
    for index, line in enumerate(tracker_lines)
    if (match := re.match(r"^- id:\s*(\S+)\s*$", line))
]
if not item_starts:
    errors.append(f"{tracker_path}: tracker contains no items")

first_item_line_by_id = {}
for start, item_id in item_starts:
    if item_id in first_item_line_by_id:
        errors.append(
            f"{tracker_path}:{start + 1}: duplicate tracker id '{item_id}'; "
            f"first declared at line {first_item_line_by_id[item_id]}"
        )
    else:
        first_item_line_by_id[item_id] = start + 1

pending_pattern = re.compile(r"^[\"']?pending(?:_|\b)", re.IGNORECASE)
for item_index, (start, item_id) in enumerate(item_starts):
    end = item_starts[item_index + 1][0] if item_index + 1 < len(item_starts) else len(tracker_lines)
    block = tracker_lines[start:end]
    status_lines = [
        (start + offset + 1, match.group(1).strip())
        for offset, line in enumerate(block)
        if (match := re.match(r"^  status:\s*(.*?)\s*$", line))
    ]
    if len(status_lines) != 1:
        errors.append(
            f"{tracker_path}:{start + 1}: {item_id} must contain exactly one item status; found {len(status_lines)}"
        )
    else:
        line_number, status = status_lines[0]
        if status not in {"verified", "wontfix"}:
            errors.append(
                f"{tracker_path}:{line_number}: {item_id} status '{status}' is not completion-terminal; expected 'verified' or 'wontfix'"
            )
        elif status == "wontfix":
            scope_lines = [
                line.strip()
                for line in block
                if re.match(r"^  release_scope:\s*\S+\s*$", line)
            ]
            if len(scope_lines) != 1:
                errors.append(
                    f"{tracker_path}:{start + 1}: {item_id} status 'wontfix' must declare exactly one release_scope"
                )

    verification_start = None
    verification_indent = None
    inline_verification = ""
    for offset, line in enumerate(block):
        match = re.match(r"^(\s*)verification:\s*(.*?)\s*$", line)
        if match:
            verification_start = offset
            verification_indent = len(match.group(1))
            inline_verification = match.group(2)
            break

    if verification_start is None:
        continue

    if pending_pattern.search(inline_verification):
        errors.append(
            f"{tracker_path}:{start + verification_start + 1}: {item_id} contains pending verification evidence: {inline_verification}"
        )

    for offset in range(verification_start + 1, len(block)):
        line = block[offset]
        if not line.strip():
            continue
        indent = len(line) - len(line.lstrip())
        if indent <= verification_indent:
            break
        evidence = re.match(r"^\s+[A-Za-z_][A-Za-z0-9_]*:\s*(.*?)\s*$", line)
        if evidence and pending_pattern.search(evidence.group(1)):
            errors.append(
                f"{tracker_path}:{start + offset + 1}: {item_id} contains pending verification evidence: {line.strip()}"
            )

matrix_completion_statuses = {"verified", "healthy", "closed", "wontfix"}
with capability_matrix_path.open(newline="") as handle:
    reader = csv.DictReader(handle)
    if reader.fieldnames is None or "status" not in reader.fieldnames:
        errors.append(f"{capability_matrix_path}: capability matrix must contain a status column")
    else:
        for line_number, row in enumerate(reader, 2):
            if None in row:
                errors.append(f"{capability_matrix_path}:{line_number}: malformed CSV row")
                continue
            status = (row.get("status") or "").strip()
            if status not in matrix_completion_statuses:
                capability = (row.get("capability") or "<unnamed capability>").strip()
                errors.append(
                    f"{capability_matrix_path}:{line_number}: {capability} status '{status}' is active; "
                    f"completion statuses are {', '.join(sorted(matrix_completion_statuses))}"
                )

if errors:
    print("\n".join(errors))
    raise SystemExit(1)
PY
    ); then
        return 0
    fi

    echo "[LR-063] local/remote parity completion gate is not closed" >&2
    echo "$diagnostics" >&2
    return 1
}

if [[ ${1:-} == "--completion-gate-only" ]]; then
    if [[ $# -ne 3 ]]; then
        echo "usage: $0 --completion-gate-only <tracker.yaml> <capability-matrix.csv>" >&2
        exit 2
    fi
    check_completion_gate "$2" "$3"
    echo "local/remote parity completion gate checks passed"
    exit 0
elif [[ ${1:-} == "--runtime-transport-callsite-inventory" ]]; then
    if [[ $# -ne 1 ]]; then
        echo "usage: $0 --runtime-transport-callsite-inventory" >&2
        exit 2
    fi
    print_runtime_transport_callsite_inventory
    exit 0
elif [[ ${1:-} == "--workspace-split-binding-inventory" ]]; then
    if [[ $# -ne 1 ]]; then
        echo "usage: $0 --workspace-split-binding-inventory" >&2
        exit 2
    fi
    rust_workspace_split_binding_inventory
    exit 0
elif [[ ${1:-} == "--session-bridge-side-effect-inventory" ]]; then
    if [[ $# -ne 1 ]]; then
        echo "usage: $0 --session-bridge-side-effect-inventory" >&2
        exit 2
    fi
    print_session_bridge_side_effect_inventory
    exit 0
elif [[ ${1:-} == "--session-binding-snapshot-inventory" ]]; then
    if [[ $# -ne 1 ]]; then
        echo "usage: $0 --session-binding-snapshot-inventory" >&2
        exit 2
    fi
    print_session_binding_snapshot_inventory
    exit 0
elif [[ $# -ne 0 ]]; then
    echo "usage: $0 [--completion-gate-only <tracker.yaml> <capability-matrix.csv> | --runtime-transport-callsite-inventory | --workspace-split-binding-inventory | --session-bridge-side-effect-inventory | --session-binding-snapshot-inventory]" >&2
    exit 2
fi

forbid_outside_shared_home() {
    local id="$1"
    local description="$2"
    local pattern="$3"
    local shared_home="$4"
    local matches

    matches=$(rg -n "$pattern" app/src --glob '*.rs' --glob "!$shared_home" || true)
    if [[ -n "$matches" ]]; then
        echo "[$id] $description" >&2
        echo "$matches" >&2
        fail=1
    fi
}

require_contract_marker() {
    local id="$1"
    local marker="$2"
    shift 2
    local paths=("$@")

    if ! rg -q --fixed-strings -- "$marker" "${paths[@]}"; then
        echo "[$id] missing contract marker '$marker' in ${paths[*]}" >&2
        fail=1
    fi
}

require_rust_test_name() {
    local id="$1"
    local test_name="$2"
    shift 2
    local paths=("$@")

    if [[ ! "$test_name" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
        echo "[$id] invalid Rust test name '$test_name'" >&2
        fail=1
        return
    fi
    if ! rg -U -P -q \
        "#\\[(?:tokio::)?test(?:\\([^]]*\\))?\\]\\s*(?:#\\[[^]]+\\]\\s*)*(?:async\\s+)?fn\\s+${test_name}\\s*\\(" \
        "${paths[@]}"; then
        echo "[$id] missing Rust test declaration '$test_name' in ${paths[*]}" >&2
        fail=1
    fi
}

require_contract_order() {
    local id="$1"
    local before="$2"
    local after="$3"
    local path="$4"

    if ! python3 -c 'import pathlib, sys; text = pathlib.Path(sys.argv[3]).read_text(); before = text.find(sys.argv[1]); after = text.find(sys.argv[2]); raise SystemExit(0 if before >= 0 and after >= 0 and before < after else 1)' "$before" "$after" "$path"; then
        echo "[$id] expected '$before' before '$after' in $path" >&2
        fail=1
    fi
}

rust_type_contains() {
    local declaration_pattern="$1"
    local member_pattern="$2"
    local path="$3"

    awk -v declaration_pattern="$declaration_pattern" -v member_pattern="$member_pattern" '
        !inside && $0 ~ declaration_pattern {
            inside = 1
            depth = 0
        }
        inside {
            if ($0 ~ member_pattern) {
                found = 1
            }
            line = $0
            opens = gsub(/\{/, "{", line)
            closes = gsub(/\}/, "}", line)
            depth += opens - closes
            if (depth == 0) {
                inside = 0
            }
        }
        END { exit !found }
    ' "$path"
}

