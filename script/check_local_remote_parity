if rg -n 'volume_serial_number\(|file_index\(|_expected: \(u64, u64\)' app/src/sftp_manager/sftp_backend.rs; then
    echo "[LR-098] unstable or ignored Windows staging identity remains" >&2
    fail=1
fi

# LR-099: release-helper contract tests assert each target invocation
# independently instead of coupling behavior to shell indentation.
require_contract_marker "LR-099" "RELEASE-HELPER-STATIC-GUARD-08" docs/LOCAL_REMOTE_PARITY_SPEC.yaml
require_contract_marker "LR-099" "id: LR-099" docs/design/local-remote-parity-tracker.yaml
require_contract_marker "LR-099" "release helper test: format-independent target assertions" docs/design/local-remote-capability-matrix.csv
require_contract_marker "LR-099" '"build_linux_helper x86_64-unknown-linux-musl x86_64"' app/src/remote_server/dev_remote_install.rs
require_contract_marker "LR-099" '"build_linux_helper aarch64-unknown-linux-musl aarch64"' app/src/remote_server/dev_remote_install.rs
if rg -n 'build_linux_helper x86_64-unknown-linux-musl x86_64\\n\\' app/src/remote_server/dev_remote_install.rs; then
    echo "[LR-099] whitespace-coupled release-helper assertion remains" >&2
    fail=1
fi

# LR-105: checkout source identity and product release identity are independent.
# A workflow_dispatch candidate ref must still use inputs.tag for every product artifact.
require_contract_marker "LR-105" "RELEASE-SOURCE-REF-PRODUCT-VERSION-14" docs/LOCAL_REMOTE_PARITY_SPEC.yaml
require_contract_marker "LR-105" "id: LR-105" docs/design/local-remote-parity-tracker.yaml
require_contract_marker "LR-105" "release workflow: source ref and product version separation" docs/design/local-remote-capability-matrix.csv
require_contract_marker "LR-105" "SOURCE_REF: \${{ github.ref }}" .github/workflows/release.yml
require_contract_marker "LR-105" "RELEASE_TAG: \${{ github.event_name == 'workflow_dispatch' && github.event.inputs.tag || github.ref_name }}" .github/workflows/release.yml
require_contract_marker "LR-105" "group: release-\${{ github.event_name == 'workflow_dispatch' && github.event.inputs.tag || github.ref_name }}" .github/workflows/release.yml
require_contract_marker "LR-105" "validate-release-identity:" .github/workflows/release.yml
require_contract_marker "LR-105" "Product release tag must match vMAJOR.MINOR.PATCH" .github/workflows/release.yml
require_contract_marker "LR-105" "fn release_workflow_separates_source_ref_from_product_version" app/src/remote_server/dev_remote_install.rs
release_identity_dependents=$(awk '
    /^  [A-Za-z0-9_-]+:$/ {
        job = $1
        sub(/:$/, "", job)
    }
    /^    needs: validate-release-identity$/ { print job }
' .github/workflows/release.yml | sort)
expected_release_identity_dependents=$(printf '%s\n' \
    build-linux-cli \
    build-macos-app \
    build-macos-helpers \
    build-windows)
if [[ "$release_identity_dependents" != "$expected_release_identity_dependents" ]]; then
