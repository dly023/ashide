import csv
from pathlib import Path

for path in [
    Path("docs/design/local-remote-capability-matrix.csv"),
    Path("docs/design/local-remote-inconsistencies.csv"),
]:
    with path.open(newline="") as handle:
        rows = list(csv.reader(handle))
    expected = len(rows[0])
    invalid = [(line, len(row)) for line, row in enumerate(rows, 1) if len(row) != expected]
    if invalid:
        raise SystemExit(f"{path} columns must remain {expected}: {invalid}")
PY
