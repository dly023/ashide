    "session_bridge_fork_targets",
    "SessionBridgeForkTarget::Agent",
    "workspace-session-bridge-edit-and-fork",
    "ShowSessionBridgeEditDialog",
):
    if marker in session_context:
        violations.append(f"session_bridge_menu_items:{marker}")
if violations:
    raise SystemExit("legacy provider x action rows: " + ", ".join(violations))
PY
then
    echo "[LR-172] a top-level Agent menu rebuilt provider-specific New/Fork/Edit rows" >&2
    fail=1
